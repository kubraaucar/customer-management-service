# Copy this file to .env and change the values if you need to.
# docker compose reads .env automatically. Without a .env file the defaults below are used.
# The Spring Boot app reads the same names from environment variables.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=customer_db
DB_USERNAME=postgres
DB_PASSWORD=12345

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=12345

# Login. Production must set JWT_SECRET (32+ random characters) and ADMIN_PASSWORD.
JWT_SECRET=local-development-only-secret-change-me-0123456789
JWT_EXPIRATION=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
DEMO_ENABLED=true
